{
	"version": 3,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"title": "Style 1",
	"slug": "style-1",
	"blockTypes": ["core/post-terms"],
	"styles": {
		"typography": {
			"fontSize": "0.813rem",
			"textTransform": "uppercase",
			"fontWeight": "500"
		},

		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|default",
					"background": "var:preset|color|primary"
				},
				"spacing": {
					"padding": {
						"top": "5px",
						"right": "var:preset|spacing|10",
						"bottom": "5px",
						"left": "var:preset|spacing|10"
					}
				},
				":hover": {
					"color": {
						"text": "var:preset|color|default",
						"background": "var:preset|color|secondary"
					}
				}
			}
		}
	}
}
